{
  "name": "returntrip-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p apps/demo-app/tsconfig.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "tsc -b --clean",
    "verify:viewer": "pnpm --filter @returntrip/dashboard build:public && cd tests/kane && kane-cli testmd run .testmuai/tests/returntrip_viewer_test.md --agent"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "26.6.10",
    "fast-check": "4.11.0",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
